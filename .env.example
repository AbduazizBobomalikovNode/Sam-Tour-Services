# Bu namuna. Nusxa oling: cp .env.example .env
# .env fayli hech qachon commit qilinmaydi.

# @BotFather bergan token. Bo'sh bo'lsa faqat veb panel ishlaydi
BOT_TOKEN=

# MongoDB ulanish satri (majburiy)
DATE_URL=

# Adminlar guruhining ID raqami (masalan: -1001234567890)
ADMIN_CHAT_ID=

# Veb panel porti (standart: 8080)
PORT=8080

# Veb panelga kirish uchun login
PANEL_USER=admin

# Veb panel paroli. Bo'sh bo'lsa panel butunlay o'chiq turadi
PANEL_PASSWORD=

# 1 bo'lsa bot so'rovlari logga yoziladi (telefon raqamlar ko'rinadi, faqat nosozlikni topishda yoqing)
DEBUG=
